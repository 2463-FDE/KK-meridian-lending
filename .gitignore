# dependencies
node_modules/
.pnp
.pnp.js

# python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# next.js
frontend/.next/
frontend/out/
frontend/build/
frontend/tsconfig.tsbuildinfo

# RAG eval harness — local, disposable, content-hash-keyed embedding cache
services/loan-assistant/.embedding_cache.json

# secrets
.env
.env.loan-assistant.local

# local machine TLS-inspection root CA bundle (corporate AV/proxy, etc.) --
# never portable across machines/CI, must never be committed
certs/
services/*/combined-ca-bundle.pem

# misc
.DS_Store
*.log.bak
coverage/
.idea/
.vscode/
*.iml

# runtime log output (docker-compose mounts ./logs and services/*/logs as
# volumes -- these accumulate locally on every run, never intended to be
# committed)
logs/
services/*/logs/

# Playwright E2E (frontend/e2e) -- local/CI run artifacts, never committed.
# Traces are disabled in playwright.config.ts (see frontend/e2e/README.md
# for why); report/results are still local output either way.
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/

# Developer-local editor/agent wiring. `.mcp.json` points at a loopback port on
# whoever's machine wrote it (127.0.0.1:64342 for a JetBrains IDE), so it is
# meaningless to anyone else and actively misleading in a clone -- a teammate
# would get a config referring to a server that is not running. Ignored rather
# than committed with a "change this" comment, because the value is per-machine
# and there is nothing to standardise.
#
# Both were swept into a commit by `git add -A` and caught in review of PR #56.
.mcp.json
.ai/
