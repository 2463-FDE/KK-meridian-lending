# Local development environment. `make bootstrap` copies this to .env and
# generates the secrets marked REQUIRED below. Never commit .env.
# Values here are synthetic/local defaults for the docker compose stack, not
# credentials. Blank means unset.

# --- database and cache (required; local defaults work as-is) -----------------
POSTGRES_USER=meridian
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meridian
DB_HOST=postgres
DB_PORT=5432
DB_PASSWORD=postgres
DATABASE_URL=postgresql://meridian:postgres@postgres:5432/meridian
REDIS_URL=redis://redis:6379/0

# --- external providers (optional) --------------------------------------------
# Blank keys: with ENVIRONMENT=development the bureau, scorer and processor fall
# back to labelled deterministic stubs; outside dev/test they fail closed.
CORE_BANKING_API_KEY=
EXPERIAN_KEY=
EXPERIAN_BASE_URL=https://api.experian.example.com/v2
PROCESSOR_API_KEY=
PROCESSOR_BASE_URL=https://api.cardprocessor.example.com

# --- service URLs on the compose network (required; defaults work as-is) ------
ORIGINATION_URL=http://origination-service:8001
SERVICING_URL=http://servicing-service:8002
KYC_URL=http://kyc-service:8003
DECISION_URL=http://decision-service:8004
DISCLOSURE_URL=http://disclosure-service:8005
PAYMENT_URL=http://payment-service:8006
LOAN_ASSISTANT_URL=http://loan-assistant:8007

# --- loan assistant (optional; the stack starts without credentials) ---------
# The underwriting-summary agent runs only on Bedrock (services/loan-assistant/
# app/agent.py) and refuses any other provider. Without AWS credentials the
# service still starts; only the summary route declines to answer.
LLM_PROVIDER=bedrock
# Your own Bedrock bearer token. Nothing here is a usable credential.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# Suggested default. It must be a model id your AWS account/region has been
# granted; override it if not. The agent refuses to run when this is blank.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Only used with LLM_PROVIDER=anthropic (policy chat); the summary agent refuses
# that provider by design.
ANTHROPIC_API_KEY=

# Optional LangSmith tracing. Blank = off. When on, only metadata-only agent
# traces are sent -- never prompts, retrieved text or application data. Read
# docs/runbook.md "LangSmith tracing" before adding a LangChain/LangGraph call.
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Behind a TLS-inspecting proxy? Set these in .env.loan-assistant.local, NOT
# here (see docs/runbook.md "TLS-inspecting proxies"):
# SSL_CERT_FILE=/app/certs/<your-bundle>.pem
# REQUESTS_CA_BUNDLE=/app/certs/<your-bundle>.pem

# --- runtime ------------------------------------------------------------------
SESSION_TTL_SECONDS=28800
LOG_LEVEL=INFO
# development|dev|test|local relax the token-strength check and allow stubs.
# Unset is treated as production. Required by docker compose.
ENVIRONMENT=development

# --- internal service-to-service secret (REQUIRED, no default) ----------------
# docker compose refuses to start without it; every service gets the same value.
# A repository-known value is refused outside development/test.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SERVICE_TOKEN=

# --- signed human principal, spec 0002 REQ-ID-3 (REQUIRED, no default) --------
# Generate with:  python db/tools/generate_principal_keypair.py --env
# SIGNING_KEY is the private half (gateway only); VERIFY_KEY is the public half
# (servicing). Never commit a real pair.
PRINCIPAL_SIGNING_KEY=
PRINCIPAL_VERIFY_KEY=

# --- maker-checker limits, spec 0002 section 3 (REQUIRED; synthetic demo values)
# Copied from adr/0011-maker-checker-for-servicing-adjustments.md "Configured
# limits". Change the ADR first: db/tests/test_maker_checker_limits_have_one_source.py
# fails on drift. Demo configuration, not Lending Operations policy. There is no
# code default -- an unset limit must not be read as "no limit".
#   ADMIN_THRESHOLD          at or below: underwriter or admin may approve;
#                            above: admin only. A csr never approves.
#   MAX_DELTA                above this, a movement is refused at creation
#   PERMITTED_LOAN_STATUSES  comma-separated, exact match; unknown fails closed
MAKER_CHECKER_ADMIN_THRESHOLD=500.00
MAKER_CHECKER_MAX_DELTA=5000.00
MAKER_CHECKER_PERMITTED_LOAN_STATUSES=current
