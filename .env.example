# Copy to .env and fill in. `docker compose up` also works with no .env at all —
# every service falls back to this same non-secret "postgres" dev password so a
# clean checkout still boots. Only override these to point at a real deployment.
POSTGRES_USER=meridian
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meridian
DB_HOST=postgres
DB_PORT=5432
DB_PASSWORD=postgres
DATABASE_URL=postgresql://meridian:postgres@postgres:5432/meridian
REDIS_URL=redis://redis:6379/0
CORE_BANKING_API_KEY=
EXPERIAN_KEY=
EXPERIAN_BASE_URL=https://api.experian.example.com/v2
PROCESSOR_API_KEY=
PROCESSOR_BASE_URL=https://api.cardprocessor.example.com
ORIGINATION_URL=http://origination-service:8001
SERVICING_URL=http://servicing-service:8002
KYC_URL=http://kyc-service:8003
DECISION_URL=http://decision-service:8004
DISCLOSURE_URL=http://disclosure-service:8005
PAYMENT_URL=http://payment-service:8006
LOAN_ASSISTANT_URL=http://loan-assistant:8007
ANTHROPIC_API_KEY=
# The underwriting summary runs as an agent on Bedrock and refuses any other
# provider (services/loan-assistant/app/agent.py). Leaving this on `anthropic`
# gives you a service that starts and a summary route that will not answer.
LLM_PROVIDER=bedrock

# REQUIRED for the summary agent. Supply your own Bedrock bearer token; nothing
# here is a usable credential. The model id must be one your account/region has
# been granted, so there is no safe default.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# TLS-inspecting proxy? The container needs the interception root in a bundle:
#   python scripts/make_ca_bundle.py
# then set SSL_CERT_FILE and REQUESTS_CA_BUNDLE in .env.loan-assistant.local.
# To run the direct Anthropic API instead, set LLM_PROVIDER=anthropic -- the
# summary agent will then refuse, by design.
# ANTHROPIC_API_KEY=
# Optional LangSmith tracing. Blank = off. Read this before setting it.
#
# What used to be written here -- that traced prompts/completions are "already
# guaranteed PII-free by the redactor/field-allowlist/corpus-hygiene gate
# upstream" -- was measured and is not true of what LangSmith actually receives.
# Those gates run on what the summary RETURNS; the tracer serialises the whole
# run. One agent run with LANGSMITH_TRACING=true posted ~31KB containing the
# user prompt, the system prompt, the tool query and the retrieved policy text.
#
# The underwriting-agent path therefore keeps the framework's own tracing
# suppressed -- it still transmits 0 bytes (app/agent.py::suppressed_tracing)
# -- and emits a PRIVACY-SAFE trace of its own instead (app/trace.py).
#
# That trace carries categorical and provenance metadata only: stage names, the
# tool name, retrieval hit/miss and counts, policy document names, content-hash
# versions and citation identifiers, provider and model family, which
# deterministic validators ran and which fired, the refusal class, the HTTP
# status and durations. Its allow-list is structural -- an unreviewed key or an
# unreviewed value is dropped, not sanitised -- and it is asserted against a
# local sink that reads the actual bytes on the wire
# (tests/test_trace_is_privacy_safe.py).
#
# The trace now starts at the GATEWAY, not one hop downstream of it. The gateway
# opens a `gateway_entry` run after it authenticates and authorises the caller,
# and forwards a server-minted context that loan-assistant joins, so one trace
# covers authenticated entry through the final outcome. A caller cannot choose
# that context: the propagation headers are stripped inbound on every proxied
# route (services/gateway/app/agent_trace.py,
# services/gateway/tests/test_the_agent_trace_starts_here.py,
# services/loan-assistant/tests/test_the_trace_joins_the_gateway.py).
#
# The two paths this file used to warn about no longer send content, and the
# warning is replaced rather than softened:
#   * policy chat: `make_client()` no longer wraps the client for tracing. That
#     wrapper recorded the prompt and the completion -- the user's question plus
#     the retrieved policy excerpt -- and it did so on the ATTEMPT, not on
#     success: a wrapped client posted ~5KB carrying the question even when the
#     API call failed on authentication
#     (services/loan-assistant/tests/test_policy_chat_retains_nothing.py);
#   * decision-service and origination-service: both run LangGraph, which
#     auto-instruments through langchain-core whenever this switch is on. A
#     credit decision posted ~30KB carrying the SSN, the bureau score, the
#     applicant name, the application id and the income. Both now suppress
#     ambient tracing for the graph run and transmit 0 bytes
#     (services/decision-service/tests/test_the_decision_graph_transmits_nothing.py,
#     services/origination-service/tests/test_the_auto_offer_graph_transmits_nothing.py).
#
# What that means for this switch: enabling it produces the privacy-safe agent
# trace and nothing else. No path in this system sends prompts, completions,
# queries, retrieved text, application data or identifiers to LangSmith.
#
# If you add a LangChain or LangGraph call site, it will trace by default and it
# will trace its state. That is how both of the exposures above happened -- no
# code named LangSmith in either service. Suppress it or emit a categorical
# trace deliberately; do not assume a new path is safe because these are.
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# Corporate AV/proxy doing HTTPS inspection makes outbound LLM calls fail with
# CERTIFICATE_VERIFY_FAILED, since httpx/anthropic verify against public
# certifi, not your local trust store. If you hit that: export that root CA to
# a PEM, append it to a copy of certifi's cacert.pem, drop the combined file in
# ./certs/ (gitignored), and set BOTH of these in .env.loan-assistant.local
# (NOT this file -- every other service shares this .env via its own env_file,
# and doesn't have ./certs mounted, so setting these here breaks their outbound
# httpx calls with a FileNotFoundError instead). httpx (anthropic calls) reads
# SSL_CERT_FILE; langsmith's `requests`-based client reads REQUESTS_CA_BUNDLE
# instead and ignores SSL_CERT_FILE entirely -- set both:
# SSL_CERT_FILE=/app/certs/<your-bundle>.pem
# REQUESTS_CA_BUNDLE=/app/certs/<your-bundle>.pem
SESSION_TTL_SECONDS=28800
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- internal service-to-service secret ---------------------------------------
# REQUIRED. docker-compose.yml refuses to start without it -- there is no default,
# because a fallback committed to this repository is not a secret: the scenario the
# token defends against (a port re-exposed, the network boundary bypassed) is
# exactly the one where an attacker can read the repo.
#
# Services that check it: gateway, origination, kyc, decision, disclosure, payment,
# servicing. They must all receive the SAME value; compose wires them from this one
# variable.
#
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# A value listed in each service's config.KNOWN_DEV_TOKENS is refused at startup
# unless ENVIRONMENT is development/dev/test/local.
INTERNAL_SERVICE_TOKEN=

# --- signed human principal (spec 0002 REQ-ID-3) ------------------------------
# The gateway signs a short-lived assertion naming the staff member behind a
# money-moving request; servicing verifies it and so cannot forge one. Generate
# a pair -- nothing here is a usable key, and committing one would defeat the
# control, since whoever holds the private half can mint an admin:
#
#     python db/tools/generate_principal_keypair.py --env
#
# PRINCIPAL_SIGNING_KEY is the PRIVATE half and belongs to the gateway ALONE.
# PRINCIPAL_VERIFY_KEY is the PUBLIC half and goes to servicing.
PRINCIPAL_SIGNING_KEY=
PRINCIPAL_VERIFY_KEY=

# --- maker-checker limits (spec 0002 section 3) -------------------------------
# APPROVED FOR THIS COHORT/DEMO ENVIRONMENT ON 2026-08-16. **Not Lending
# Operations policy.** Production adoption requires Lending Operations to set or
# approve each one.
#
# SOURCE: adr/0011-maker-checker-for-servicing-adjustments.md, "Configured
# limits". That table is where the approval is recorded; the figures below are a
# COPY of it, as are spec 0002's and scripts/bootstrap_env.py's. Change the ADR
# first -- db/tests/test_maker_checker_limits_have_one_source.py fails if any
# copy drifts from it, which is the only thing keeping four transcriptions of a
# money limit honest.
#
#   ADMIN_THRESHOLD  at or below, an underwriter or admin may approve;
#                    above it, admin only. A csr never approves.
#   MAX_DELTA        above this, a movement is refused at creation, for everyone.
#   PERMITTED_LOAN_STATUSES
#                    comma-separated, compared exactly (case included). An
#                    unrecognised status fails closed.
#
# No code default: an unset limit must not be read as "no limit".
MAKER_CHECKER_ADMIN_THRESHOLD=500.00
MAKER_CHECKER_MAX_DELTA=5000.00
MAKER_CHECKER_PERMITTED_LOAN_STATUSES=current
